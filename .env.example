# Copy this file to `.env` (keep this one — it is the committed template):
#
#     cp .env.example .env
#
# `.env` is gitignored and must never be committed. Real environment variables
# set by the server take precedence over anything here, so production can set
# its own and ignore this file entirely.

# ---------------------------------------------------------------- Stripe (B2B)
# School licence invoicing. Until STRIPE_SECRET_KEY is set, every Stripe-backed
# endpoint returns 503 "Stripe is not configured" and the rest of the app runs
# normally — nothing else breaks.
# Test keys: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_replace_me

# Signing secret for POST /billing/stripe/webhook. Shown when you create the
# webhook endpoint (Developers -> Webhooks), or by `stripe listen` locally.
# The webhook REFUSES to process anything without this: an unverified endpoint
# would let anyone mark any invoice paid.
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Days a school gets to pay before the invoice is overdue.
INVOICE_DUE_DAYS=30

# ------------------------------------------------------------------------- VAT
# iRead is not VAT-registered yet, so invoices go out net with a note saying so.
# When the VAT number arrives, set both of these — that turns on Stripe Tax
# (Irish standard rate, EU B2B reverse charge) with no code change.
PLATFORM_VAT_REGISTERED=0
# PLATFORM_VAT_NUMBER=IE1234567X

# ----------------------------------------------------------------------- Seats
# Hard-block new student activations once a school hits its licensed limit.
# Leave off until the seat backfill has been checked against real schools.
SEAT_ENFORCEMENT_ENABLED=0

# Platform billing currency. iRead is an Irish company.
BILLING_CURRENCY=EUR

# ------------------------------------------------------- Database maintenance
# Lets a super admin apply pending migrations from Super Admin -> Database
# Schema. Needed on FTP hosts with no shell access.
# Turn it ON to deploy, then turn it OFF again — leaving an endpoint that can
# alter the live schema permanently reachable is not worth the convenience.
ALLOW_WEB_MIGRATIONS=0

# --------------------------------------------------------------------- Secrets
# These currently have hardcoded fallbacks in config.py. Move the real values
# here and delete them from the committed source.
# SECRET_KEY=
# CALL_JWT_SECRET=
# ADMIN_FRONT_URL=https://admin.iread.education
